# Copy this file to config.env and customize to run ./deploy.sh non-interactively.
# Any variable left blank or omitted will be prompted for interactively.

AWS_REGION="eu-west-1"
STAGE="prod"
KB_MODE="vector"              # vector (S3 Vectors + RetrieveAndGenerate) | managed (Managed KB / SharePoint + Retrieve/Converse)
MEMORY_MODE="single"          # single | multi
APP_NAME="bedrock-rag"        # lowercase letters, numbers, hyphens
PREFIX="lab"                  # lowercase letters, numbers, hyphens
TAG_COST_CENTRE="IT"
TAG_RESOURCE_ID="001"

# Optional: set an existing Guardrail ID to reuse & preserve it instead of creating a new one
# GUARDRAIL_ID="xojv3g7paumh"
GUARDRAIL_VERSION="DRAFT"

# Optional: reuse an existing Bedrock Knowledge Base to skip S3/S3 Vectors setup
# and BDA re-ingestion/embedding token costs. Populated automatically if you choose
# to keep the Knowledge Base during ./teardown.sh.
# KB_NAME=""
# KB_ID=""

# Optional (Future / Managed KB with SharePoint connector):
# Choose the Microsoft Graph / SharePoint App Registration permission scope:
#   Sites.Selected  (Recommended - least privilege): Restricts the connector to explicitly
#                   granted SharePoint sites only. Requires a SharePoint Admin to grant
#                   per-site access to the Entra ID App Registration.
#   Sites.Read.All  (Tenant-wide read): Grants read access to ALL SharePoint sites across
#                   the tenant. Faster initial setup, but wider security blast radius.
SHAREPOINT_PERMISSION_SCOPE="Sites.Selected"   # Sites.Selected | Sites.Read.All

# Optional: customize the post-deploy smoke test question (or set RUN_SMOKE_TEST="false")
RUN_SMOKE_TEST="true"
SMOKE_TEST_PROMPT="Give a brief 2-sentence summary of the documents in this knowledge base."
