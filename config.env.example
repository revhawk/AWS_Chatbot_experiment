# Copy this file to config.env and customize to run ./deploy.sh non-interactively.
# Any variable left blank or omitted will be prompted for interactively.

AWS_REGION="eu-west-1"
STAGE="prod"
MEMORY_MODE="single"          # single | multi
APP_NAME="bedrock-rag"        # lowercase letters, numbers, hyphens
PREFIX="lab"                  # lowercase letters, numbers, hyphens
TAG_COST_CENTRE="IT"
TAG_RESOURCE_ID="001"

# Optional: set an existing Guardrail ID to reuse it instead of creating a new one
# GUARDRAIL_ID=""
GUARDRAIL_VERSION="DRAFT"
