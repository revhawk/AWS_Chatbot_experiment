# Copy to frontend/.env.local for local development
# Auth mode: "mock_oidc" (sandbox/offline dev) | "entra_id" (Microsoft Entra ID OIDC PKCE)
VITE_AUTH_MODE="mock_oidc"
VITE_API_BASE_URL="/api"

# Required when VITE_AUTH_MODE="entra_id"
VITE_ENTRA_TENANT_ID=""
VITE_ENTRA_CLIENT_ID=""
VITE_ENTRA_SCOPE="api://bedrock-rag-assistant/chat.read"
VITE_REDIRECT_URI="https://your-app-hostname/"
